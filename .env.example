# Copy to .env.local and fill in. `npx supabase status` prints the local values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Shared secret pg_cron sends to /api/internal/jobs/run (local value matches supabase/seed.sql).
JOB_SECRET=local-dev-job-secret

# AI router config. Use config/ai.config.mock.json to run without any AI keys.
AI_CONFIG_FILE=config/ai.config.json
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Show the email magic-link sign-in (local testing; emails land in http://127.0.0.1:54324).
NEXT_PUBLIC_ENABLE_EMAIL_LOGIN=true

# Realistic AI try-on (IDM-VTON for tops, Leffa for bottoms and dresses). Strongly recommended:
# without a token you share the anonymous GPU quota, which runs out after a run or two a day.
# A free read token (huggingface.co/settings/tokens) gives you your own allowance.
HF_TOKEN=
# Free on-device tagging and garment cut-outs (CLIP + a clothes parser, ~260 MB of models). For
# your own machine only: leave it unset on Vercel, where tagging uses GEMINI_API_KEY instead.
LOCAL_VISION=1
# Where the on-device models are kept (default: .cache/models in the project).
# MODEL_CACHE_DIR=
# AI 3D avatars (image-to-3D). Optional; the first key that is set is used, in this order:
# fal.ai Trellis (pay-as-you-go, about $0.02 a model), Tripo (credits), Meshy (paid API plan).
FAL_KEY=
TRIPO_API_KEY=
MESHY_API_KEY=
# Local development only: link to the mailbox that catches Supabase emails (Mailpit).
NEXT_PUBLIC_DEV_MAILBOX_URL=http://127.0.0.1:54324

# --- Production ------------------------------------------------------------
# Grievance / contact email shown on /privacy and /terms (required before launch under India's DPDP Act).
NEXT_PUBLIC_CONTACT_EMAIL=

# Error tracking (Sentry free tier). Leave empty to send nothing.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Only for uploading source maps from CI.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Login CAPTCHA (Cloudflare Turnstile, free). Set the site key here and enable [auth.captcha]
# with the secret key in Supabase -> Authentication -> Bot and abuse protection.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Services (services/vision, services/avatar, services/tryon). Each is switched on by setting its
# URL; unset, the web app does that work itself as before. SERVICE_SECRET (32+ characters, the same
# value in every service) signs calls both ways; events come back to /api/internal/events.
SERVICE_SECRET=
VISION_URL=
AVATAR_URL=
TRYON_URL=
