# Port to listen on (7860 also suits a Hugging Face Docker Space).
PORT=7860
# Shared with the web app and the other services; at least 32 characters.
SERVICE_SECRET=change-me-to-a-long-random-string-32+
# Where item.processed events go: POST {WEB_URL}/api/internal/events
WEB_URL=http://localhost:3000
# Supabase project URL and secret (service) key. The key never leaves this server.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=
# Where CLIP, the clothes parser and u2net download on first use (~900 MB).
MODEL_CACHE_DIR=./.cache/models
# debug | info | warn | error
LOG_LEVEL=info
# Optional: cloud taggers tried before the on-device one (see config/ai.config.json).
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Optional: another chain config file.
# AI_CONFIG_FILE=./config/ai.config.json
