*
!packages/contracts-py/pyproject.toml
!packages/contracts-py/warewise_contracts
!services/tryon/requirements.lock
!services/tryon/pyproject.toml
!services/tryon/app
!services/tryon/config
**/__pycache__
**/*.egg-info
