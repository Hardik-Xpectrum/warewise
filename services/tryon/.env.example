PORT=7860
# Shared with the web app, 32+ characters.
SERVICE_SECRET=
# Where tryon.ready / tryon.failed events go (POST {WEB_URL}/api/internal/events).
WEB_URL=http://localhost:3000
# `npx supabase status` prints the local URL and secret key. Schema `tryon` must be exposed to the API.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=
# Optional: your own ZeroGPU allowance instead of the anonymous one.
HF_TOKEN=
LOG_LEVEL=info
# config/ai.config.offline.json = composite only (no GPU)
AI_CONFIG_FILE=config/ai.config.json
STORAGE_BUCKET=wardrobe
# off = HTTP API only; run `python -m app.worker` elsewhere
WORKER=on
WORKER_IDLE_MS=5000
