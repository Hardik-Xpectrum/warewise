# Port to listen on (7860 also suits a Hugging Face Docker Space).
PORT=7860
# Shared with the web app and the other services; at least 32 characters.
SERVICE_SECRET=change-me-to-a-long-random-string-32+
# Where avatar.ready / avatar.failed events go: POST {WEB_URL}/api/internal/events
WEB_URL=http://localhost:3000
# Supabase project URL and secret (service) key. The key never leaves this server.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=
# Free ZeroGPU quota for the Hugging Face Spaces (anonymous use works with less).
HF_TOKEN=
# debug | info | warn | error
LOG_LEVEL=info
# Optional paid photo engines, tried only when their keys are set.
FAL_KEY=
TRIPO_API_KEY=
MESHY_API_KEY=
# Optional: replace every engine chain, e.g. mock-3d for development without GPU quota.
# AVATAR_ENGINES=mock-3d
# Optional overrides.
# AI_CONFIG_FILE=./config/ai.config.json
# STORAGE_BUCKET=wardrobe
# WORKER_INTERVAL_MS=5000
