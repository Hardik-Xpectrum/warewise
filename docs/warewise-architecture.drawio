y"/></mxCell><mxCell id="c36" value="GitHub Actions CI: lint · types · 142 unit tests · npm audit · RLS gate · smoke test · Playwright e2e (desktop + phone)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="c35"><mxGeometry x="15" y="40" width="640" height="60" as="geometry"/></mxCell><mxCell id="c37" value="deploy.yml (when DEPLOY_ENABLED): supabase db push → vercel build/deploy" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="c35"><mxGeometry x="680" y="40" width="360" height="60" as="geometry"/></mxCell><mxCell id="c38" value="warewise.in (GoDaddy DNS → Vercel)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="c35"><mxGeometry x="1060" y="40" width="310" height="60" as="geometry"/></mxCell><mxCell id="c39" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c40" value="fetch JSON / SSE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c41" value="PUT photo (signed URL)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="c9" target="c25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c42" value="supabase-js (user&#x27;s JWT → RLS)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;