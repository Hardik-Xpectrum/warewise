<mxfile host="app.diagrams.net" agent="Warewise docs" version="24.0.0"><diagram id="arch" name="1 · Architecture"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Warewise: system architecture" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontStyle=1;fontSize=20;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="700" height="40" as="geometry"/></mxCell><mxCell id="c3" value="User&#xa;(phone or laptop browser,&#xa;installable PWA)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="170" height="80" as="geometry"/></mxCell><mxCell id="c4" value="1 · Browser (Next.js client, React 19)" style="swimlane;rounded=0;whiteSpace=wrap;html=1;startSize=30;fontStyle=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="250" y="70" width="420" height="560" as="geometry"/></mxCell><mxCell id="c5" value="Pages: Today · Wardrobe (+ fitting room) · Stylist (swipe deck) · Try-on · Plan · Outfits · Shop · Insights · Profile · Welcome" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="c4"><mxGeometry x="15" y="40" width="390" height="70" as="geometry"/></mxCell><mxCell id="c6" value="useApi shared cache&#xa;(src/lib/query.ts)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="c4"><mxGeometry x="15" y="120" width="185" height="55" as="geometry"/></mxCell><mxCell id="c7" value="Realtime listener&#xa;(item status updates)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="c4"><mxGeometry x="220" y="120" width="185" height="55" as="geometry"/></mxCell><mxCell id="c8" value="On-device, free &amp; private:&#xa;• pose landmarks (MediaPipe)&#xa;• optional background removal (imgly)&#xa;• quick try-on preview (canvas warp)&#xa;• 3D avatar viewer (three.js)&#xa;• live mirror (camera)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#eef4fb;strokeColor=#666666;align=left;spacingLeft=8;" vertex="1" parent="c4"><mxGeometry x="15" y="185" width="390" height="125" as="geometry"/></mxCell><mxCell id="c9" value="Photos go straight to Storage&#xa;with a signed upload URL" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="c4"><mxGeometry x="15" y="320" width="390" height="45" as="geometry"/></mxCell><mxCell id="c10" value="Talks to the server only through /api/v1 (JSON) and one Server-Sent Events stream (stylist). Never holds secret keys." style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#fff8dc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="15" y="375" width="390" height="70" as="geometry"/></mxCell><mxCell id="c11" value="Security headers + CSP&#xa;(next.config.ts)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="c4"><mxGeometry x="15" y="455" width="390" height="45" as="geometry"/></mxCell><mxCell id="c12" value="2 · Server (Next.js 16 on Vercel, region bom1)" style="swimlane;rounded=0;whiteSpace=wrap;html=1;startSize=30;fontStyle=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="720" y="70" width="470" height="560" as="geometry"/></mxCell><mxCell id="c13" value="proxy.ts: refreshes the Supabase session cookie, sends signed-out visitors to /login" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="c12"><mxGeometry x="15" y="40" width="440" height="45" as="geometry"/></mxCell><mxCell id="c14" value="/api/v1/* route handlers&#xa;authed() wrapper · zod validation · origin check · rate limits · daily caps (take_usage)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;fontStyle=1;" vertex="1" parent="c12"><mxGeometry x="15" y="95" width="440" height="60" as="geometry"/></mxCell><mxCell id="c15" value="Domain modules (src/modules): wardrobe · stylist · tryon · avatar · outfits · shopping · insights · identity · media · samples · platform" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="c12"><mxGeometry x="15" y="165" width="440" height="60" as="geometry"/></mxCell><mxCell id="c16" value="AI router (src/modules/ai)&#xa;config/ai.config*.json: job → chain of models, tried in order, skipped without key / quota" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="c12"><mxGeometry x="15" y="235" width="440" height="60" as="geometry"/></mxCell><mxCell id="c17" value="/api/internal/jobs/run (secret header)&#xa;Job runner: media jobs (tag + cut-out) · try-on jobs · 3D model jobs" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#e1f5e1;strokeColor=#666666;" vertex="1" parent="c12"><mxGeometry x="15" y="305" width="440" height="60" as="geometry"/></mxCell><mxCell id="c18" value="/api/health (DB + AI config check, for uptime monitors)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="c12"><mxGeometry x="15" y="375" width="440" height="40" as="geometry"/></mxCell><mxCell id="c19" value="Stylist replies stream as SSE: status → instant rule-based preview → message → outfits → done" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#fff8dc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="15" y="425" width="440" height="55" as="geometry"/></mxCell><mxCell id="c20" value="3 · Supabase (Postgres + Auth + Storage)" style="swimlane;rounded=0;whiteSpace=wrap;html=1;startSize=30;fontStyle=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1240" y="70" width="400" height="560" as="geometry"/></mxCell><mxCell id="c21" value="Auth: email magic link, Google" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="c20"><mxGeometry x="15" y="40" width="370" height="40" as="geometry"/></mxCell><mxCell id="c22" value="Postgres with row-level security on every table:&#xa;profiles · consents · wardrobe_items · outfits · outfit_items · recommendations · feedback · wear_log · avatar_photos · tryon_results · avatar_models · planned_outfits · daily_picks · usage_counters · ai_interactions" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;align=left;spacingLeft=8;" vertex="1" parent="c20"><mxGeometry x="15" y="90" width="370" height="120" as="geometry"/></mxCell><mxCell id="c23" value="pgmq queues:&#xa;media_jobs · tryon_jobs · model3d_jobs&#xa;(an item set to &#x27;processing&#x27; enqueues itself)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="c20"><mxGeometry x="15" y="220" width="370" height="70" as="geometry"/></mxCell><mxCell id="c24" value="pg_cron + pg_net:&#xa;every minute → POST jobs/run&#xa;nightly: housekeeping, stale outfits, daily picks, old plans" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="c20"><mxGeometry x="15" y="300" width="370" height="75" as="geometry"/></mxCell><mxCell id="c25" value="Storage bucket &#x27;wardrobe&#x27; (private, signed URLs):&#xa;original / clean / thumb / cutout · avatar photos · try-on renders · 3D .glb" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="c20"><mxGeometry x="15" y="385" width="370" height="70" as="geometry"/></mxCell><mxCell id="c26" value="Realtime: pushes wardrobe_items updates" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="c20"><mxGeometry x="15" y="465" width="370" height="40" as="geometry"/></mxCell><mxCell id="c27" value="4 · External services" style="swimlane;rounded=0;whiteSpace=wrap;html=1;startSize=30;fontStyle=1;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1690" y="70" width="330" height="700" as="geometry"/></mxCell><mxCell id="c28" value="Gemini (free tier) → OpenRouter&#xa;jobs: tagger, stylist" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="c27"><mxGeometry x="15" y="40" width="300" height="50" as="geometry"/></mxCell><mxCell id="c29" value="local-vision (your machine only, LOCAL_VISION=1):&#xa;CLIP tags + SegFormer clothes cut-out" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#fffaf0;strokeColor=#666666;" vertex="1" parent=