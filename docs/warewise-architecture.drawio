get="c32"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c50" value="scan link (SSRF-safe)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="c15" target="c33"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c51" value="item ready" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#9673a6;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="c26" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c52" value="clean / cutout / render / glb" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c17" target="c25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c53" value="on main" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c36" target="c37"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c54" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c37" target="c38"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="flows" name="2 · Workflows"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c55" value="Warewise: main workflows" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontStyle=1;fontSize=20;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="700" height="40" as="geometry"/></mxCell><mxCell id="c56" value="A · Add a piece of clothing (Wardrobe → Add)" style="swimlane;rounded=0;whiteSpace=wrap;html=1;startSize=30;fontStyle=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="1840" height="200" as="geometry"/></mxCell><mxCell id="c57" value="1. Take or choose photos&#xa;(camera or file picker; 2 uploads at a time)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="c56"><mxGeometry x="15" y="45" width="170" height="130" as="geometry"/></mxCell><mxCell id="c58" value="2. POST /uploads&#xa;→ signed upload URL&#xa;(cap 100/day)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="c56"><mxGeometry x="215" y="45" width="170" height="130" as="geometry"/></mxCell><mxCell id="c59" value="3. PUT photo to Storage&#xa;POST /items → row &#x27;processing&#x27;&#xa;(trigger enqueues media_jobs)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="c56"><mxGeometry x="415" y="45" width="170" height="130" as="geometry"/></mxCell><mxCell id="c60" value="4. Job runner (after() or pg_cron):&#xa;validate type &amp; size,&#xa;strip EXIF/GPS, WebP,&#xa;thumbnail, perceptual hash" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#e1f5e1;strokeColor=#666666;" vertex="1" parent="c56"><mxGeometry x="615" y="45" width="170" height="130" as="geometry"/></mxCell><mxCell id="c61" value="5. Tagger chain:&#xa;Gemini → OpenRouter&#xa;→ local-vision → mock&#xa;(category, colours, pattern,&#xa;formality, season, fabric)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#666666;" vertex="1" parent="c56"><mxGeometry x="815" y="45" width="170" height="130" as="geometry"/></mxCell><mxCell id="c62" value="6. Cut-out:&#xa;clothes parser (local)&#xa;or plain-background keyer" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#666666;" vertex="1" parent="c56"><mxGeometry x="1015" y="45" width="170" height="130" as="geometry"/></mxCell><mxCell id="c63" value="7. Duplicate check (phash)&#xa;save clean / thumb / cutout&#xa;status → &#x27;ready&#x27;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#e1f5e1;strokeColor=#666666;" vertex="1" parent="c56"><mxGeometry x="1215" y="45" width="170" height="130" as="geometry"/></mxCell><mxCell id="c64" value="8. Realtime update&#xa;→ card appears in the grid,&#xa;ready for Stylist &amp; Try-on" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="c56"><mxGeometry x="1415" y="45" width="170" height="130" as="geometry"/></mxCell><mxCell id="c65" value="If tagging fails: retries ×3,&#xa;then &#x27;Needs attention&#x27;&#xa;(user can retry or edit tags)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#666666;" vertex="1" parent="c56"><mxGeometry x="1615" y="45" width="170" height="130" as="geometry"/></mxCell><mxCell id="c66" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c57" target="c58"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c67" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c58" target="c59"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c68" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c59" target="c60"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c69" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c60" target="c61"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c70" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c61" target="c62"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c71" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c62" target="c63"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c72" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c63" target="c64"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c73" value="B · Ask the stylist (Stylist page, swipe deck)" style="swimlane;rounded=0;whiteSpace=wrap;html=1;startSize=30;fontStyle=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="300" width="1840" height="200" as="geometry"/></mxCell><mxCell id="c74" value="1. Tap an occasion chip&#xa;or type (&#x27;client meeting,&#xa;want to stay cool&#x27;)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="c73"><mxGeometry x="15" y="45" width="170" height="130" as="geometry"/></mxCell><mxCell id="c75" value="2. POST …/messages (SSE)&#xa;occasion from text,&#xa;daily cap check" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="c73"><mxGeometry x="215" y="45" width="170" height="130" as="geometry"/></mxCell><mxCell id="c76" value="3. Weather for city &amp; date&#xa;(Open-Meteo, cached)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="c73"><mxGeometry x="415" y="45" width="170" height="130" as="geometry"/></mxCell><mxCell id="c77" value="4. Load wardrobe + taste&#xa;(likes, wears, 45-day decay);&#xa;filter by occasion &amp; weather" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="c73"><mxGeometry x="615" y="45" width="170" height="130" as="geometry"/></mxCell><mxCell id="c78" value="5. Stream instant&#xa;&#x27;Quick pick&#x27; built by rules&#xa;(colour harmony score)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#e1f5e1;strokeColor=#666666;" vertex="1" parent="c73"><mxGeometry x="815" y="45" width="170" height="130" as="geometry"/></mxCell><mxCell id="c79" value="6. AI stylist chain picks&#xa;outfits from item ids;&#xa;validated, mood/colour filter" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#666666;" vertex="1" parent="c73"><mxGeometry x="1015" y="45" width="170" height="130" as="geometry"/></mxCell><mxCell id="c80" value="7. No valid AI outfits?&#xa;rule engine fallback&#xa;+ &#x27;what&#x27;s missing&#x27; note" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="c73"><mxGeometry x="1215" y="45" width="170" height="130" as="geometry"/></mxCell><mxCell id="c81" value="8. Save outfits &amp;&#xa;recommendations,&#xa;stream cards" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="c73"><mxGeometry x="1415" y="45" width="170" height="130" as="geometry"/></mxCell><mxCell id="c82" value="9. Swipe: right = like&#xa;(saved + favourite),&#xa;left = pass → taste learns" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#e1f5e1;strokeColor=#666666;" vertex="1" parent="c73"><mxGeometry x="1615" y="45" width="170" height="130" as="geometry"/></mxCell><mxCell id="c83" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c74" target="c75"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c84" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c75" target="c76"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c85" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c76" target="c77"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c86" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c77" target="c78"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c87" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c78" target="c79"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c88" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c79" target="c80"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c89" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c80" target="c81"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c90" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c81" target="c82"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c91" value="C · Try it on (Try-on page)" style="swimlane;rounded=0;whiteSpace=wrap;html=1;startSize=30;fontStyle=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="530" width="1840" height="200" as="geometry"/></mxCell><mxCell id="c92" value="1. Tap pieces (wear rules:&#xa;new top replaces top,&#xa;real jacket layers over,&#xa;dress replaces top+bottom)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="c91"><mxGeometry x="15" y="45" width="170" height="130" as="geometry"/></mxCell><mxCell id="c93" value="2. Quick preview, instant:&#xa;cut-outs warped onto&#xa;body landmarks (canvas)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#e1f5e1;strokeColor=#666666;" vertex="1" parent="c91"><mxGeometry x="215" y="45" width="170" height="130" as="geometry"/></mxCell><mxCell id="c94" value="3. &#x27;Make it realistic&#x27;:&#xa;consent check, cap 10/day;&#xa;existing render reused" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="c91"><mxGeometry x="415" y="45" width="170" height="130" as="geometry"/></mxCell><mxCell id="c95" value="4. POST /tryon → row&#xa;&#x27;pending&#x27; → tryon_jobs" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="c91"><mxGeometry x="615" y="45" width="170" height="130" as="geometry"/></mxCell><mxCell id="c96" value="5. Runner plans passes:&#xa;top → IDM-VTON (~60 s GPU)&#xa;bottom/dress → Leffa&#xa;(each falls back to the other)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#666666;" vertex="1" parent="c91"><mxGeometry x="815" y="45" width="170" height="130" as="geometry"/></mxCell><mxCell id="c97" value="6. Partial result kept if&#xa;GPU time runs out&#xa;(note says what was skipped)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="c91"><mxGeometry x="1015" y="45" width="170" height="130" as="geometry"/></mxCell><mxCell id="c98" value="7. Render saved (WebP),&#xa;viewer switches to&#xa;&#x27;Realistic&#x27; automatically" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#e1f5e1;strokeColor=#666666;" vertex="1" parent="c91"><mxGeometry x="1215" y="45" width="170" height="130" as="geometry"/></mxCell><mxCell id="c99" value="8. 3D: &#x27;Looks like me&#x27; built&#xa;from the render; or AI 3D&#xa;(TRELLIS → .glb, 3/day)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="c91"><mxGeometry x="1415" y="45" width="170" height="130" as="geometry"/></mxCell><mxCell id="c100" value="Instant preview is always&#xa;free &amp; unlimited;&#xa;AI renders use the free&#xa;Hugging Face GPU allowance" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#fff8dc;strokeColor=#666666;" vertex="1" parent="c91"><mxGeometry x="1615" y="45" width="170" height="130" as="geometry"/></mxCell><mxCell id="c101" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c92" target="c93"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c102" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c93" target="c94"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c103" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c94" target="c95"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c104" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c95" target="c96"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c105" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c96" target="c97"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c106" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c97" target="c98"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c107" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c98" target="c99"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c108" value="D · Daily loop &amp; housekeeping" style="swimlane;rounded=0;whiteSpace=wrap;html=1;startSize=30;fontStyle=1;fontSize=14;fillColor=#f5f5f5;strokeColor=#666666;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="760" width="1840" height="200" as="geometry"/></mxCell><mxCell id="c109" value="Welcome flow (first sign-in):&#xa;name, city, sizes,&#xa;style quiz, clothes or samples" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="c108"><mxGeometry x="15" y="45" width="170" height="130" as="geometry"/></mxCell><mxCell id="c110" value="Today: planned outfit wins,&#xa;else daily pick for the&#xa;weather; shuffle, &#x27;I wore this&#x27;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="c108"><mxGeometry x="215" y="45" width="170" height="130" as="geometry"/></mxCell><mxCell id="c111" value="Plan: week planner&#xa;(auto-plan, no repeats)&#xa;+ trip packer (capsule)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="c108"><mxGeometry x="415" y="45" width="170" height="130" as="geometry"/></mxCell><mxCell id="c112" value="Shop Scan: paste a link or&#xa;photo → AI tags → harmony&#xa;&amp; gap check → verdict" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="c108"><mxGeometry x="615" y="45" width="170" height="130" as="geometry"/></mxCell><mxCell id="c113" value="Insights: cost per wear,&#xa;in rotation, neglected&#xa;pieces" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="c108"><mxGeometry x="815" y="45" width="170" height="130" as="geometry"/></mxCell><mxCell id="c114" value="pg_cron nightly: clean stale&#xa;outfits &amp; old plans,&#xa;precompute daily picks,&#xa;reset rate windows" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="c108"><mxGeometry x="1015" y="45" width="170" height="130" as="geometry"/></mxCell><mxCell id="c115" value="Profile: autosave,&#xa;consents (AI try-on opt-in),&#xa;export data, delete account&#xa;(DPDP Act)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="c108"><mxGeometry x="1215" y="45" width="170" height="130" as="geometry"/></mxCell><mxCell id="c116" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c109" target="c110"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c117" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c110" target="c111"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
