# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example

# supabase local secrets
supabase/.env
supabase/.temp

# copied from node_modules on install
/public/mediapipe/

# Playwright
/test-results/
/playwright-report/
/e2e/.auth/

# On-device AI models (downloaded on first use)
/.cache

# Python services
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Local service logs (scripts/services-dev.sh)
/.services-logs
